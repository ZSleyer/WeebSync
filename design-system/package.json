{
  "name": "fluid-lycoris",
  "version": "0.1.0",
  "description": "Fluid Lycoris: Material 3 Expressive motion with a red/teal colour code. Theme tokens, component styles and presentational React components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "./build.sh"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
