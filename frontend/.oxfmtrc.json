{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "public/**",
    ".yarn/**",
    "src/api.gen.ts",
    "**/*.md",
    "**/*.html",
    "**/*.css",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml"
  ]
}
